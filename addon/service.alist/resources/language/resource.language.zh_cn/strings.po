msgctxt "#30002"
msgid "Admin password"
msgstr "管理员密码"

msgctxt "#30011"
msgid "HTTP port of the AList web UI and WebDAV endpoint. The service restarts when changed."
msgstr "AList 网页界面与 WebDAV 使用的 HTTP 端口。修改后服务自动重启。"

msgctxt "#30012"
msgid "Password for the built-in admin user. Applied on the next service start; leave empty to keep the password managed inside AList."
msgstr "内置 admin 用户的密码。下次服务启动时生效；留空则沿用 AList 内部的密码。"

msgctxt "#30020"
msgid "Access"
msgstr "访问"

msgctxt "#30021"
msgid "Web UI: http://<device-ip>:<web port>"
msgstr "网页地址：http://<设备IP>:<网页端口>"

msgctxt "#30022"
msgid "Username: admin"
msgstr "用户名：admin"

msgctxt "#30023"
msgid "Data folder: /storage/.kodi/userdata/addon_data/service.alist/data"
msgstr "数据目录：/storage/.kodi/userdata/addon_data/service.alist/data"
